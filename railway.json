{
  "$schema": "https://railway.com/reference/config/railway-json",
  "services": {
    "web": {
      "source": {
        "repo": "Cbarr32/siteguru",
        "branch": "Master"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "pnpm start"
      }
    },
    "worker": {
      "source": {
        "repo": "Cbarr32/siteguru",
        "branch": "Master"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "worker/Dockerfile"
      },
      "deploy": {
        "startCommand": "node dist/index.js",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
      }
    }
  }
}
