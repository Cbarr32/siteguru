# ╔══════════════════════════════════════════════════════════════════╗
# ║                    SiteGuru — Environment Variables             ║
# ║  Copy this file to .env and fill in the values.                ║
# ║  Lines starting with # are comments.                           ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── App ─────────────────────────────────────────────────────────
# Base URL of the running application (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Random secret used to encrypt session cookies (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"

# Default city for weather panel (used when no user location is set)
DEFAULT_CITY="Minneapolis"

# ─── Database (Railway PostgreSQL) ───────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siteguru"

# ─── Redis (Railway Redis) ───────────────────────────────────────
# Redis connection string (optional — app degrades gracefully without it)
REDIS_URL="redis://localhost:6379"

# ─── Google (Gmail, Calendar, YouTube, Meet) ─────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── GitHub ──────────────────────────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Spotify ─────────────────────────────────────────────────────
# Spotify Developer Dashboard → Create App → Settings
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ─── Microsoft (Teams, Meet, Presence) ───────────────────────────
# Azure Portal → App registrations → New registration
MICROSOFT_ENTRA_ID_CLIENT_ID=""
MICROSOFT_ENTRA_ID_CLIENT_SECRET=""

# ─── Facebook / Instagram ────────────────────────────────────────
# Meta for Developers → My Apps → Create App → Consumer
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─── Weather (OpenWeatherMap) ────────────────────────────────────
# https://openweathermap.org/api → Sign Up → API keys
OPENWEATHER_API_KEY=""

# ─── Anthropic (Agent AI) ────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""
